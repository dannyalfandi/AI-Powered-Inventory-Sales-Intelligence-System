# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored — never commit real credentials.
# Values must match infra/.env (POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB /
# POSTGRES_PORT and REDIS_PASSWORD / REDIS_PORT). Placeholders below mirror
# infra/.env.example.

# HTTP server port
PORT=8080

# PostgreSQL: postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>?sslmode=disable
DATABASE_URL=postgres://inventory:change_me_postgres@localhost:5432/inventory_intel?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=change_me_redis
REDIS_DB=0

# Low-stock threshold for products that don't have their own (default 10)
LOW_STOCK_DEFAULT_THRESHOLD=10

# Gin mode: debug | release | test
GIN_MODE=debug

# IANA time zone of business dates, e.g. the date in order numbers SO-YYYYMMDD-NNNN
APP_TIMEZONE=Asia/Jakarta

# Analytics cache TTL for summary/sales-trend (0 disables caching)
ANALYTICS_CACHE_TTL=5m
