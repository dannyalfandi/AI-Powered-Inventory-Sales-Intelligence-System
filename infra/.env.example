# Copy to .env and adjust values:  cp .env.example .env
# .env is git-ignored — never commit real credentials.
# Only variables read by docker-compose.yml belong here. The API container's
# DATABASE_URL / REDIS_ADDR are built in docker-compose.yml from the values below.
#
# Host ports below are the standard defaults (same as docker-compose.yml and
# backend/.env.example). Machine-specific values (e.g. 5433, 6380, 8090 when
# the defaults are taken) go in your git-ignored infra/.env, not here.

# Compose project name (prefix for containers/volumes/images)
COMPOSE_PROJECT_NAME=inventory-intel
TZ=Asia/Jakarta

# PostgreSQL (the password ends up in a URL: avoid @ : / ? # % in it)
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=inventory_intel
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me-local
REDIS_PORT=6379

# ML service (starts with plain `docker compose up`); host port
ML_PORT=8000

# Go API (profile "app"); host port
API_PORT=8080

# Required for profile "app" (the API refuses to start without it); plain
# `docker compose up` does not need it. At least 32 characters; generate with:
#   openssl rand -base64 48
JWT_SECRET=

# Optional, profile "seed": the Super Admin account the seeder creates.
# Empty = the seeder's default credential (see backend/README.md).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
