# Copy to .env and adjust:  cp .env.example .env
# .env is git-ignored; nothing here is secret, the service is stateless.

# HTTP port for uvicorn
PORT=8000

# critical | error | warning | info | debug
LOG_LEVEL=info

# --- Forecasting defaults (optional; the values below are the built-in ones) ---
# Moving-average window in days when the request does not send window_days
DEFAULT_WINDOW_DAYS=7
# Hard limits, exceeded => HTTP 422
MAX_WINDOW_DAYS=90
MAX_HORIZON_DAYS=90
MIN_HISTORY_POINTS=3
# Each compared period in /insight/trend
TREND_WINDOW_DAYS=14
# Which registered forecaster to use (see app/services/forecasting.py)
FORECAST_METHOD=moving_average
